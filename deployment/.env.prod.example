# Production environment template.
#
# Copy to .env.prod and fill in your values:
#   cp deployment/.env.prod.example deployment/.env.prod
#
# Then start the stack:
#   docker compose --env-file .env.prod -f deployment/compose.prod.yaml up -d --build
#
# The production stack bundles only the web app and Redis; the database,
# object storage, and mail server are external/managed services. Variables
# marked (required) are checked by Docker Compose, which refuses to start
# until they are set.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# (required) Long random value, e.g. generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated hosts for your app, e.g. app.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# PostgreSQL (managed database)
# ---------------------------------------------------------------------------
# (required) Hostname of your managed Postgres, e.g. db.example.com
POSTGRES_HOST=

POSTGRES_DB=onest
POSTGRES_USER=onest
# (required)
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# S3-compatible object storage (AWS S3, MinIO, Cloudflare R2, ...)
# ---------------------------------------------------------------------------
# (required)
AWS_ACCESS_KEY_ID=
# (required)
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=onest
# Set for S3-compatible endpoints (MinIO, R2); leave empty for real AWS S3.
AWS_S3_ENDPOINT_URL=
# Optional: public host media URLs are built from, e.g. media.example.com.
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=us-east-1
# "virtual" (default, AWS S3) or "path" (MinIO-style endpoints).
AWS_S3_ADDRESSING_STYLE=virtual
AWS_S3_URL_PROTOCOL=https:
USE_S3=1

# ---------------------------------------------------------------------------
# Email (external SMTP relay)
# ---------------------------------------------------------------------------
# (required to send mail) e.g. smtp.example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Onest <noreply@onest.local>

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure) SSO — see README "Microsoft setup"
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---------------------------------------------------------------------------
# Web service (optional)
# ---------------------------------------------------------------------------
WEB_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
