# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Django runtime files
db.sqlite3
staticfiles/

# Local media uploads (protected storage, headshots, previews, exports)
media/*
!media/.gitkeep

# Environment
.env
deployment/.env.prod

# Frontend (Node)
node_modules/

# Vite build output (served by Django via STATICFILES_DIRS)
assets/*

# Keep the directory in git so Django check passes before the first build
!assets/.gitkeep


node_modules/*

# Claude Code — personal, machine-local overrides (shared config is .claude/settings.json)
.claude/settings.local.json

# Impeccable design skill — vendored per harness by `npx impeccable install`
# (~2 MB each) and reinstallable at any time, so none of it belongs in git.
# Reinstall with: npx impeccable install --providers=claude,cursor,codex,github
.claude/skills/impeccable/
.cursor/skills/impeccable/
.cursor/agents/impeccable-*
.agents/skills/impeccable/
.github/skills/impeccable/
.github/agents/impeccable-*
.github/hooks/impeccable.json

# Impeccable hook manifests — written by the installer, machine-local.
.cursor/hooks.json
.codex/hooks.json

# Impeccable working state — config caches, hook bookkeeping, live-mode
# artifacts and receipts. Its shareable outputs are DESIGN.md and PRODUCT.md
# at the repo root, which are tracked.
.impeccable/
.impeccable-live/
.impeccable-live.json
