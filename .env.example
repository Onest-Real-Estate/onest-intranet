[TEMPLATE]
# Copy to .env and fill in your values.
#   cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Object storage (MinIO) — used by the compose stack (deployment/compose.*.yaml).
# The same credentials are used as the S3 access key/secret for Django
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=onest

# DocuSeal (document signing) — dev-only service (deployment/compose.dev.yaml)
DOCUSEAL_PORT=3000
# Browser / embed origin (host-mapped DocuSeal UI). Must match TLS reality —
# local compose is HTTP; @docuseal/react defaults to HTTPS and will fail here.
DOCUSEAL_BASE_URL=http://localhost:3000
# Embedded builder/form JS require DocuSeal Pro. Community image serves an
# “Upgrade to Pro” stub; hub falls back to DocuSeal’s own UI + new-tab signing.
# Server-side API origin. Leave empty for local `runserver` (falls back to
# DOCUSEAL_BASE_URL). Docker compose sets http://docuseal:3000 automatically.
# DOCUSEAL_API_URL=
DOCUSEAL_API_KEY=
# Email of the DocuSeal admin that owns the API key (required for template builder JWT).
DOCUSEAL_USER_EMAIL=
# Prefill submitter email used when auto-completing commercial fields on issue.
# DOCUSEAL_PREFILL_EMAIL=contracts-prefill@onest.local
# Shared token for the DocuSeal → oNEST webhook. Self-hosted DocuSeal has no
# HMAC secret UI — generate a long random value and paste it into the webhook
# URL query string DocuSeal will call, e.g.:
#   http://host.docker.internal:8000/webhooks/docuseal/contracts?token=...
# Cloud DocuSeal may instead send X-Docuseal-Signature (HMAC); same env var.
DOCUSEAL_WEBHOOK_SECRET=
# Short-lived recipient signing intent TTL (seconds). Default 15 minutes.
# DOCUSEAL_SIGNING_INTENT_TTL_SECONDS=900

# Celery (background tasks) — the compose stacks default to Redis DBs 1/2 so
# the broker/result backend never compete with the cache on db 0.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Run tasks inline instead of queueing them. Turn this on when developing
# without `make up`: an enqueued task with no worker to consume it never runs,
# and an announcement's hero image then sits in PENDING for ever, blocking
# publication. Leave it off anywhere a real worker exists.
# CELERY_TASK_ALWAYS_EAGER=1

# Error tracking (Sentry SDK) — send to sentry.io or PostHog error tracking.
# PostHog accepts Sentry SDK events; use its Sentry-compatible DSN (project
# API key, see PostHog docs → Error tracking). Empty disables the SDK.
SENTRY_DSN=
# development | production | staging ...
SENTRY_ENVIRONMENT=development
# 0 disables tracing; raise (e.g. 0.1 = 10%) in production for performance monitoring
SENTRY_TRACES_SAMPLE_RATE=0
# Send user data (email etc.) as PII with events
SENTRY_SEND_DEFAULT_PII=0

# Absolute base for links in outbound mail. Notification email contains no
# record detail — only a link back into the hub, which re-authenticates on
# arrival — so this must point at the app itself, never at a storage host.
SITE_BASE_URL=http://localhost:8000

# Logging level for first-party code (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=DEBUG

# Optional HTTPS help-centre URL. Empty keeps the shell entry point disabled.
HUB_HELP_URL=

# Record which dashboard Quick Access launchers get opened. Rows carry a link's
# stable key and never its URL. 0 stops the recording; the beacon endpoint keeps
# answering 204, so turning it off costs a count and never a click.
QUICK_ACCESS_CLICK_ANALYTICS=1

# Production: use the dedicated template at deployment/.env.prod.example.

# Microsoft Entra ID (Azure) app registration — see README "Microsoft setup".
# https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (personal + work/school), "organizations", "consumers", or a tenant id
MICROSOFT_TENANT=common
