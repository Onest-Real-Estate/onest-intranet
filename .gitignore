# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Django runtime files
db.sqlite3
staticfiles/

# Local media uploads (protected storage, headshots, previews, exports)
media/*
!media/.gitkeep

# Environment
.env
deployment/.env.prod

# Frontend (Node)
node_modules/

# Vite build output (served by Django via STATICFILES_DIRS)
assets/*

# Keep the directory in git so Django check passes before the first build
!assets/.gitkeep


node_modules/*

# Claude Code — personal, machine-local overrides (shared config is .claude/settings.json)
.claude/settings.local.json

# Impeccable design skill: vendored by `npx impeccable install`, ~2 MB, and
# reinstallable at any time. The project's own skills (add-page, checks,
# design-system) are team-authored and stay in git.
.claude/skills/impeccable/

# Impeccable working state — config caches, hook bookkeeping, live-mode
# artifacts and receipts. Its shareable outputs are DESIGN.md and PRODUCT.md
# at the repo root, which are tracked.
.impeccable/
.impeccable-live/
.impeccable-live.json
