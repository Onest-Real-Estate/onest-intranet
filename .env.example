[TEMPLATE]
# Copy to .env and fill in your values.
#   cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Object storage (MinIO) — used by the compose stack (deployment/compose.*.yaml).
# The same credentials are used as the S3 access key/secret for Django
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=onest

# Hub-native agent contract e-sign
# Short-lived recipient signing intent TTL (seconds). Default 15 minutes.
# CONTRACT_SIGNING_INTENT_TTL_SECONDS=900
# Optional org PKCS#12 used to PAdES-seal signed PDFs (required in production).
# CONTRACT_SIGNING_CERT_PATH=
# CONTRACT_SIGNING_CERT_PASSPHRASE=
# When DEBUG=1 and no cert is configured, allow unsigned completion in local
# development. Leave false in production.
# CONTRACT_SIGNING_ALLOW_UNSIGNED_DEV=1
# Optional Mistral Document AI OCR for Hub field suggestions.
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# Optional chat for announcement article digests (Generate summary). Azure
# OpenAI, OpenAI, or Gemini OpenAI-compat. Extracted page text is short-lived
# cache only; accepted copy is stored on the announcement after the author
# reviews it. Leave unset to keep Generate summary disabled.
# CONTRACT_FIELD_AI_ENDPOINT=
# CONTRACT_FIELD_AI_API_KEY=
# CONTRACT_FIELD_AI_DEPLOYMENT=
# CONTRACT_FIELD_AI_API_VERSION=2024-08-01-preview
# CONTRACT_FIELD_AI_MODEL=gpt-4o

# Notification push providers — email is always on. Microsoft Graph / Slack
# stay dormant until enabled *and* credentialed.
# NOTIFICATION_MICROSOFT_ENABLED=0
# NOTIFICATION_MICROSOFT_CLIENT_ID=
# NOTIFICATION_MICROSOFT_CLIENT_SECRET=
# NOTIFICATION_MICROSOFT_TENANT=
# NOTIFICATION_SLACK_ENABLED=0
# NOTIFICATION_SLACK_BOT_TOKEN=
# Contract reminder cadences (comma-separated days; defaults shown).
# CONTRACT_SIGNATURE_REMINDER_DAYS is settings-only: (3, 7, 14)
# CONTRACT_EXPIRATION_WARNING_DAYS is settings-only: (30, 14, 7)

# Celery (background tasks) — the compose stacks default to Redis DBs 1/2 so
# the broker/result backend never compete with the cache on db 0.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Run tasks inline instead of queueing them. Turn this on when developing
# without `make up`: an enqueued task with no worker to consume it never runs,
# and an announcement's hero image then sits in PENDING for ever, blocking
# publication. Leave it off anywhere a real worker exists.
# CELERY_TASK_ALWAYS_EAGER=1

# Error tracking (Sentry SDK) — send to sentry.io or PostHog error tracking.
# PostHog accepts Sentry SDK events; use its Sentry-compatible DSN (project
# API key, see PostHog docs → Error tracking). Empty disables the SDK.
SENTRY_DSN=
# development | production | staging ...
SENTRY_ENVIRONMENT=development
# 0 disables tracing; raise (e.g. 0.1 = 10%) in production for performance monitoring
SENTRY_TRACES_SAMPLE_RATE=0
# Send user data (email etc.) as PII with events
SENTRY_SEND_DEFAULT_PII=0

# Absolute base for links in outbound mail. Notification email contains no
# record detail — only a link back into the hub, which re-authenticates on
# arrival — so this must point at the app itself, never at a storage host.
SITE_BASE_URL=http://localhost:8000

# Logging level for first-party code (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=DEBUG

# Optional HTTPS help-centre URL. Empty keeps the shell entry point disabled.
HUB_HELP_URL=

# Record which dashboard Quick Access launchers get opened. Rows carry a link's
# stable key and never its URL. 0 stops the recording; the beacon endpoint keeps
# answering 204, so turning it off costs a count and never a click.
QUICK_ACCESS_CLICK_ANALYTICS=1

# Production: use the dedicated template at deployment/.env.prod.example.

# Local-only allauth email/password views. Defaults to DJANGO_DEBUG: on for
# runserver, off in deployed environments (DJANGO_DEBUG=0). Leave unset or 0
# in production — the hub is Microsoft SSO only.
# ALLOW_PASSWORD_LOGIN=1

# Microsoft Entra ID (Azure) app registration — see README "Microsoft setup".
# https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (personal + work/school), "organizations", "consumers", or a tenant id
MICROSOFT_TENANT=common
