[TEMPLATE]
# Copy to .env and fill in your values.
#   cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Object storage (MinIO) — used by the compose stack (deployment/compose.*.yaml).
# The same credentials are used as the S3 access key/secret for Django
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=onest

# DocuSeal (document signing) — dev-only service (deployment/compose.dev.yaml)
DOCUSEAL_PORT=3000

# Celery (background tasks) — the compose stacks default to Redis DBs 1/2 so
# the broker/result backend never compete with the cache on db 0.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Error tracking (Sentry SDK) — send to sentry.io or PostHog error tracking.
# PostHog accepts Sentry SDK events; use its Sentry-compatible DSN (project
# API key, see PostHog docs → Error tracking). Empty disables the SDK.
SENTRY_DSN=
# development | production | staging ...
SENTRY_ENVIRONMENT=development
# 0 disables tracing; raise (e.g. 0.1 = 10%) in production for performance monitoring
SENTRY_TRACES_SAMPLE_RATE=0
# Send user data (email etc.) as PII with events
SENTRY_SEND_DEFAULT_PII=0

# Logging level for first-party code (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=DEBUG

# Production: use the dedicated template at deployment/.env.prod.example.

# Microsoft Entra ID (Azure) app registration — see README "Microsoft setup".
# https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (personal + work/school), "organizations", "consumers", or a tenant id
MICROSOFT_TENANT=common
